{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "node_modules",
    "site",
    "mcp/node_modules",
    "dist",
    "e2e/challenges/pages"
  ],
  "env": {
    "browser": true,
    "es2024": true,
    "webextensions": true,
    "node": true
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "off",
    "no-empty": "off"
  }
}
