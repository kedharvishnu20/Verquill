{
  "name": "verquill",
  "version": "3.0.0",
  "license": "MIT",
  "private": true,
  "description": "Chrome MV3 extension for visual web automation and data extraction.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node scripts/check-syntax.mjs",
    "lint": "oxlint --config .oxlintrc.json .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node --test --test-concurrency=1 --test-timeout=300000 e2e/run.mjs e2e/panel.mjs",
    "challenges": "node --test --test-concurrency=1 --test-timeout=900000 e2e/challenges.mjs",
    "mirror-challenges": "NODE_USE_ENV_PROXY=1 node scripts/mirror-challenges.mjs",
    "build": "node scripts/build-dist.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "1.82.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=18"
  }
}
